# npm run setup generates these secrets and the first admin password.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/little-chat.sqlite
SESSION_SECRET=
ENCRYPTION_KEY=
ADMIN_PASSWORD_HASH=
WEBHOOK_VERIFY_TOKEN=
# Use a supported version from your Meta app dashboard.
META_API_VERSION=v24.0
# Set to 1 only behind one trusted reverse proxy. Bind/firewall accordingly.
TRUST_PROXY=0

# Vercel production: set these through the project environment settings.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CRON_SECRET=

# Public text shown on privacy/deletion pages; never put secrets here.
# Blank contact directs requests to the Instagram account sending replies.
PRIVACY_CONTACT=
PRIVACY_PROVIDERS=
